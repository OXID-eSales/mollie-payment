# Copy to `.env` and fill in real sandbox values before running these tests.
# NEVER commit `.env` — it is gitignored.

# Shop under test.
SHOP_URL=https://your-shop.example
MOLLIE_E2E_SHOP_URL=https://your-shop.example

# Frontend customer used by the checkout spec.
TEST_USER_EMAIL=playwright.user@oxid-esales.dev
TEST_USER_PASSWORD=useruser

# Admin backend login (Admin > Extensions > Modules > Mollie Payment must already be
# configured with a Mollie TEST API key on this shop before running).
ADMIN_USER_EMAIL=admin@your-shop.example
ADMIN_USER_PASSWORD=change-me

# Mollie test-mode API key (test_...) — this is the credential that does not exist in this
# development sandbox; obtain one from https://my.mollie.com/dashboard/ > Developers > API keys.
# Tests do NOT read this directly (the key is configured in the shop's admin, not injected by
# Playwright) — it's listed here so a human setting up a runner knows what's required upstream.
MOLLIE_TEST_API_KEY=test_replace_me

HEADLESS=true
