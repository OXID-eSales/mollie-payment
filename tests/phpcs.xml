<?xml version="1.0"?>
<ruleset name="Mollie Payment Module">
    <description>PHP CodeSniffer configuration for the Mollie Payment Module (ported from PayPal/Stripe).</description>

    <rule ref="PSR12">
        <exclude name="PSR2.Classes.PropertyDeclaration.Underscore"/>
    </rule>

    <file>../src</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <!-- Do NOT add a bare */var/* pattern here. Under the Docker mount this
         module lives at /var/www/extensions/..., so */var/* matches every file,
         PHPCS scans nothing and exits 0 — a gate that always passes. It cost
         payment-base a red CI on STRP-168. -->
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg value="p"/>
    <arg name="colors"/>
    <arg value="s"/>
</ruleset>
