{
  "name": "oxid-esales/mollie-payment",
  "description": "Mollie Payment Module for OXID eShop 7 — built on the Smart-Contract payment-base",
  "type": "oxideshop-module",
  "homepage": "https://github.com/OXID-eSales/mollie-payment",
  "license": [
    "proprietary"
  ],
  "keywords": [
    "oxid",
    "modules",
    "eShop",
    "payment",
    "mollie"
  ],
  "authors": [
    {
      "name": "OXID eSales AG",
      "email": "info@oxid-esales.com"
    }
  ],
  "support": {
    "issues": "https://github.com/OXID-eSales/mollie-payment/issues",
    "source": "https://github.com/OXID-eSales/mollie-payment"
  },
  "conflict": {
    "oxid-esales/oxideshop-ce": "<7.4"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "doctrine/dbal": "^2.13 || ^3.0",
    "mollie/mollie-api-php": "^2.0",
    "oxid-esales/payment-base": ">=v1.2",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "symfony/console": "^6.4 || ^7.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0.2",
    "squizlabs/php_codesniffer": "^3.10",
    "phpmd/phpmd": "^2.15",
    "oxid-esales/oxideshop-ce": "dev-b-7.4.x",
    "phpunit/phpunit": "^11.4",
    "oxid-esales/developer-tools": "dev-b-7.4.x"
  },
  "autoload": {
    "psr-4": {
      "OxidEsales\\Payments\\Mollie\\": "./src/Mollie"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OxidEsales\\Payments\\Mollie\\Tests\\": "./tests",
      "OxidEsales\\EshopCommunity\\Tests\\": "./vendor/oxid-esales/oxideshop-ce/tests"
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=tests/phpcs.xml src/",
    "phpstan": "phpstan analyse -c tests/PhpStan/phpstan.neon",
    "phpmd": "phpmd src text tests/PhpMd/phpmd.xml --baseline-file tests/PhpMd/phpmd.baseline.xml --exclude tests/ --suffixes php --strict",
    "phpunit": "phpunit -c tests/phpunit.xml",
    "style": [
      "@phpcs",
      "@phpstan",
      "@phpmd"
    ]
  },
  "config": {
    "allow-plugins": {
      "oxid-esales/oxideshop-composer-plugin": true,
      "oxid-esales/oxideshop-unified-namespace-generator": true
    }
  }
}
