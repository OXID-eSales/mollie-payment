* text=auto

# Keep the composer dist package to what the shop actually runs.
# Everything below stays in the git repository but is stripped from the
# archive composer downloads (`--prefer-dist`, i.e. the default install).
# LICENSE, README.md and CHANGELOG.md are deliberately NOT ignored.

/.claude            export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.gitleaks.toml     export-ignore

# Contributor-facing documents and developer helper scripts.
/CLAUDE.md                      export-ignore
/bin                            export-ignore
/debug-product-checkout.mjs     export-ignore

# Untracked as of v1.0.0-rc.1; listed so a re-added copy cannot reach the
# package.
/test-results       export-ignore

# Frontend build chain. assets/ ships pre-built, nothing is built during an
# installation.
/resources          export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore

# Tests and static analysis configuration.
/tests              export-ignore

# Internal process documentation. The written documentation
# (architecture, for_developer, for_merchant, security) stays.
/docs/dev_day_log   export-ignore
