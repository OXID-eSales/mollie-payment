{#
 # Mollie Checkout Footer Widget — one-page-checkout (OPC).
 #
 # Renders the same inline experience as the standard order page (IFRAME-04): a Mollie method
 # selector plus inline Mollie Components card fields. Self-registers a Stimulus controller with
 # OPC's exported app; on submit it posts the chosen method + card token to OPC's processCheckout
 # (which forwards them via the agnostic PaymentContext metadata bag) and follows the Mollie redirect
 # URL the handler returns. Mollie's hosted page cannot be framed (IFRAME-03) — only the method/card
 # entry is inline; the payment itself still completes via redirect.
 #}
<div class="checkout-footer-mollie"
     data-controller="mollie-checkout-footer mollie-user-data-validator"
     data-mollie-checkout-footer-payment-method-value="{{ checkoutData.paymentMethodId }}"
     data-mollie-checkout-footer-csrf-token-value="{{ checkoutData.csrfToken }}"
     {# MOL-15: the validator posts the live address fields to payment-base's central endpoint with
        Mollie's module id before the footer posts processCheckout; same rules as the classic flow. #}
     data-mollie-user-data-validator-url-value="{{ checkoutData.validationUrl }}"
     data-mollie-user-data-validator-plugin-id-value="{{ checkoutData.pluginModuleId }}"
     data-mollie-user-data-validator-csrf-value="{{ checkoutData.csrfToken }}"
     data-mollie-user-data-validator-allowed-value="{{ checkoutData.fieldAllowed|json_encode|e('html_attr') }}"
     data-mollie-user-data-validator-review-message-value="{{ translate({ ident: 'MOLLIE_VALIDATION_REVIEW_ADDRESS' }) }}"
     data-mollie-checkout-footer-profile-id-value="{{ mollieConfig.profileId }}"
     data-mollie-checkout-footer-testmode-value="{{ mollieConfig.testmode ? 'true' : 'false' }}"
     data-mollie-checkout-footer-locale-value="{{ mollieConfig.locale }}"
     data-mollie-checkout-footer-inline-card-value="{{ mollieConfig.inlineCardEnabled ? 'true' : 'false' }}"
     data-mollie-checkout-footer-debug-value="{{ mollieConfig.debug ? 'true' : 'false' }}">

    {% if mollieConfig.methods is not empty %}
        {% if mollieConfig.methods|length == 1 %}
            {# One enabled method is not a choice (same rule as the standard order page): name it,
               don't offer a selector. The radio stays — hidden, checked, still a `methodRadio`
               target — so `_selectedMethod()` finds it and the method rides through processCheckout. #}
            {% set m = mollieConfig.methods|first %}
            <input type="radio" name="mollieMethod" id="mollieFooterMethod_{{ m.id }}" value="{{ m.id }}"
                   checked hidden
                   data-mollie-checkout-footer-target="methodRadio"
                   data-mollie-order-method="fixed">
            <p class="mb-3 d-flex align-items-center" data-mollie-order-card="method">
                <span class="fw-bold me-2">{{ translate({ ident: "PAYMENT_METHOD" }) }}:</span>
                {% if m.image %}
                    <img src="{{ m.image }}" alt="" width="28" height="28" class="mollie-method-icon me-2">
                {% endif %}
                {{ m.name }}
            </p>
        {% else %}
            <p class="mb-2 fw-bold">{{ translate({ ident: "MOLLIE_CHOOSE_METHOD" }) }}</p>
            <div class="mollie-methods mb-3">
                {% for m in mollieConfig.methods %}
                    <div class="form-check d-flex align-items-center py-1">
                        <input class="form-check-input me-2" type="radio" name="mollieMethod"
                               id="mollieFooterMethod_{{ m.id }}" value="{{ m.id }}"
                               {% if loop.first %}checked{% endif %}
                               data-mollie-checkout-footer-target="methodRadio"
                               data-action="change->mollie-checkout-footer#methodChanged">
                        <label class="form-check-label d-flex align-items-center" for="mollieFooterMethod_{{ m.id }}">
                            {% if m.image %}
                                <img src="{{ m.image }}" alt="" width="28" height="28" class="mollie-method-icon me-2">
                            {% endif %}
                            {{ m.name }}
                        </label>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {# Inline card fields — shown by the controller only when "creditcard" is selected. #}
        <div data-mollie-checkout-footer-target="cardFields" class="mollie-card-fields mb-3" style="display: none;">
            <label class="form-label">{{ translate({ ident: "MOLLIE_CARD_NUMBER" }) }}</label>
            <div data-mollie-checkout-footer-target="cardNumber" class="mollie-field form-control mb-2"></div>

            <label class="form-label">{{ translate({ ident: "MOLLIE_CARD_HOLDER" }) }}</label>
            <div data-mollie-checkout-footer-target="cardHolder" class="mollie-field form-control mb-2"></div>

            <div class="row">
                <div class="col">
                    <label class="form-label">{{ translate({ ident: "MOLLIE_CARD_EXPIRY" }) }}</label>
                    <div data-mollie-checkout-footer-target="expiryDate" class="mollie-field form-control"></div>
                </div>
                <div class="col">
                    <label class="form-label">{{ translate({ ident: "MOLLIE_CARD_CVC" }) }}</label>
                    <div data-mollie-checkout-footer-target="verificationCode" class="mollie-field form-control"></div>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="alert alert-danger mt-2" data-mollie-checkout-footer-target="error"
         style="display: none;" role="alert">
        <span data-mollie-checkout-footer-target="errorMessage"></span>
    </div>

    <div class="d-flex justify-content-end align-items-center mt-3">
        <button type="button" class="btn btn-primary btn-lg"
                data-mollie-checkout-footer-target="submitButton"
                data-action="click->mollie-checkout-footer#submitPayment"
                disabled>
            {{ translate({ ident: "SUBMIT_ORDER" }) }}
        </button>
    </div>
</div>

<script>
(function() {
  'use strict';

  var opc = window.OnepageCheckout;
  if (!opc || !opc.stimulus || !opc.Controller) {
    console.error('[MollieCheckoutFooter] OnepageCheckout not found - stimulus:', !!opc?.stimulus, 'Controller:', !!opc?.Controller);
    return;
  }

  var MOLLIE_JS = 'https://js.mollie.com/v1/mollie.js';
  var FIELDS = ['cardNumber', 'cardHolder', 'expiryDate', 'verificationCode'];
  var BaseController = opc.Controller;

  // Kept on window, not on the controller: OPC re-injects this footer via
  // innerHTML and re-runs this script, so the controller instance AND the
  // button element are replaced while a checkout is still in flight.
  var MollieCheckoutFooterSubmitState = window.__oeMollieCheckoutFooterSubmit || (
    window.__oeMollieCheckoutFooterSubmit = {
      _busy: false,
      inFlight: function () { return this._busy === true; },
      begin: function () { this._busy = true; },
      end: function () { this._busy = false; }
    }
  );

class MollieCheckoutFooterController extends BaseController {
    static values = {
      paymentMethod: String,
      csrfToken: String,
      profileId: String,
      testmode: Boolean,
      locale: String,
      inlineCard: Boolean,
      debug: Boolean
    }

    static targets = [
      'submitButton', 'error', 'errorMessage', 'methodRadio', 'cardFields',
      'cardNumber', 'cardHolder', 'expiryDate', 'verificationCode'
    ]

    connect() {
      this._connected = true;
      this._components = {};
      this._mdbg('[MollieCheckoutFooter] Connected');
      if (this.hasSubmitButtonTarget) {
        // Never hand the button back while a checkout is still in flight.
        // OPC re-injects this footer and calls forceControllerReconnect(), so
        // connect() runs again mid-submit; re-enabling here let a second click
        // start a SECOND checkout, which is how one purchase ended up as two
        // orders a second apart (one cancelled, one live).
        this.submitButtonTarget.disabled = MollieCheckoutFooterSubmitState.inFlight();
      }
      this._syncCardMode();
    }

    disconnect() {
      // OPC injects the footer via innerHTML then re-runs this <script> and calls
      // forceControllerReconnect(), so connect() fires more than once. Mark this instance
      // disconnected (checked after the async Mollie.js load) and clear any iframes it mounted,
      // so exactly ONE set of Components survives instead of a doubled set.
      this._connected = false;
      this._clearMountedFields();
      this._components = {};
      this._mollie = null;
    }

    _clearMountedFields() {
      var mounts = this.element.querySelectorAll(
        '[data-mollie-checkout-footer-target="cardNumber"],' +
        '[data-mollie-checkout-footer-target="cardHolder"],' +
        '[data-mollie-checkout-footer-target="expiryDate"],' +
        '[data-mollie-checkout-footer-target="verificationCode"]'
      );
      mounts.forEach(function(m) { m.innerHTML = ''; });
    }

    _mdbg() {
      if (this.debugValue === true) {
        console.log.apply(console, arguments);
      }
    }

    /** data-action: change->mollie-checkout-footer#methodChanged on the method radios. */
    methodChanged() {
      this._syncCardMode();
    }

    _selectedMethod() {
      var checked = this.hasMethodRadioTarget
        ? this.methodRadioTargets.find(function(r) { return r.checked; })
        : null;
      return checked ? checked.value : '';
    }

    _isCardMode() {
      return this.inlineCardValue === true && this._selectedMethod() === 'creditcard';
    }

    _syncCardMode() {
      var card = this._isCardMode();
      if (this.hasCardFieldsTarget) {
        this.cardFieldsTarget.style.display = card ? '' : 'none';
      }
      if (card) {
        this._ensureComponents();
      }
    }

    async submitPayment(event) {
      if (event) event.preventDefault();

      // The in-flight mark lives outside the controller on purpose: the footer
      // is re-injected via innerHTML, so both this instance and the button
      // element are replaced while the first checkout is still running.
      if (MollieCheckoutFooterSubmitState.inFlight()) {
        this._mdbg('[MollieCheckoutFooter] submit already in flight - ignoring repeat click');
        return;
      }
      MollieCheckoutFooterSubmitState.begin();

      this._hideError();
      this._setLoading(true);

      try {
        var cardToken = null;
        if (this._isCardMode()) {
          cardToken = await this._tokenize();
          if (!cardToken) {
            MollieCheckoutFooterSubmitState.end();
            this._setLoading(false);
            return; // tokenization error already shown
          }
        }

        var result = await this._processCheckout(this._selectedMethod(), cardToken);
        if (!result.success) {
          throw new Error(result.errorMessage || result.error || 'Payment could not be started.');
        }

        var meta = result.metadata || {};
        var redirectUrl = meta.redirectUrl || result.redirectUrl;
        if (!redirectUrl) {
          throw new Error('Mollie did not return a redirect URL.');
        }
        this._mdbg('[MollieCheckoutFooter] Redirecting to Mollie:', redirectUrl);
        window.location.href = redirectUrl;
      } catch (err) {
        console.error('[MollieCheckoutFooter] Payment failed:', err);
        // Released only on failure: a successful submit navigates to Mollie,
        // and the shopper must not be able to start a second one on the way out.
        MollieCheckoutFooterSubmitState.end();
        this._showError(err.message);
        this._setLoading(false);
      }
    }

    async _processCheckout(method, cardToken) {
      // The OPC CheckoutService rejects processCheckout unless both consent flags are true; forward
      // the live checkbox state (missing checkbox → true, mirroring the Stripe footer).
      var termsEl = document.getElementById('confirmTermsCheckout');
      var privacyEl = document.getElementById('confirmPrivacyCheckout');

      var body = {
        paymentMethodId: this.paymentMethodValue,
        confirmTermsAndConditions: termsEl ? !!termsEl.checked : true,
        confirmPrivacyPolicy: privacyEl ? !!privacyEl.checked : true
      };
      // Provider-specific fields — OPC forwards them into the PaymentContext metadata bag.
      if (method) { body.mollieMethod = method; }
      if (cardToken) { body.mollieCardToken = cardToken; }

      var resp = await fetch('/index.php?cl=OeCheckoutApi&fnc=processCheckout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': this.csrfTokenValue },
        credentials: 'same-origin',
        body: JSON.stringify(body)
      });
      if (!resp.ok) throw new Error('HTTP error: ' + resp.status);
      var text = await resp.text();
      try {
        return JSON.parse(text);
      } catch (e) {
        console.error('[MollieCheckoutFooter] Invalid JSON response:', text.substring(0, 200));
        throw new Error('Server returned an invalid response. Please try again.');
      }
    }

    async _tokenize() {
      await this._ensureComponents();
      if (!this._mollie) {
        this._showError('Card form is not ready. Please try again.');
        return null;
      }
      try {
        var res = await this._mollie.createToken();
        if (res.error) {
          this._showError(res.error.message || 'Please check your card details.');
          return null;
        }
        return res.token;
      } catch (e) {
        this._mdbg('[MollieCheckoutFooter] createToken failed', e);
        this._showError('Could not process the card. Please try again.');
        return null;
      }
    }

    async _ensureComponents() {
      // Idempotent against OPC's double-connect: bail if already mounted or a mount is in flight.
      if (this._mollie || this._mountingComponents) return;
      // The classic order page carries its own Mollie Components block
      // (data-controller="mollie-components"), and that is the one the customer
      // sees. Mounting a second set here — inside the collapsed accordion, so
      // invisible — leaves Mollie's library holding two sets for the same
      // fields, and the visible ones then throw on every focus, blur and
      // keystroke ("Cannot read properties of undefined (reading 'isLoaded' /
      // 'setLabel' / 'touched' / 'focusInput')"), which makes the card
      // unfillable. Stand down and let the order page host them.
      if (this._orderPageOwnsTheCardFields()) {
        this._mdbg('[MollieCheckoutFooter] order page hosts the card fields — standing down');
        return;
      }
      if (!this.profileIdValue) {
        this._mdbg('[MollieCheckoutFooter] no profile id — cannot mount Components');
        return;
      }
      this._mountingComponents = true;
      try {
        await this._loadMollieJs();
        // If OPC disconnected this instance during the async load (forceControllerReconnect),
        // do NOT mount — the freshly reconnected instance will. Prevents a second field set.
        if (!this._connected) return;
        if (!window.Mollie) {
          this._showError('Mollie.js is unavailable.');
          return;
        }
        this._mollie = window.Mollie(this.profileIdValue, {
          locale: this.localeValue || 'en_US',
          testmode: this.testmodeValue === true
        });
        for (var i = 0; i < FIELDS.length; i++) {
          var name = FIELDS[i];
          var mount = this[name + 'Target'] ? this[name + 'Target'] : null;
          if (!mount) continue;
          mount.innerHTML = ''; // drop any leftover component before mounting (belt-and-suspenders)
          var component = this._mollie.createComponent(name);
          component.mount(mount);
          this._components[name] = component;
        }
        this._mdbg('[MollieCheckoutFooter] Components mounted', Object.keys(this._components));
      } finally {
        this._mountingComponents = false;
      }
    }

    /**
     * True when the classic order page hosts its own Mollie Components block.
     * On the OPC one-page checkout there is no such block and this widget is the
     * only host, so it mounts as before.
     */
    _orderPageOwnsTheCardFields() {
      var host = document.querySelector('[data-controller~="mollie-components"]');
      return Boolean(host) && Boolean(host.querySelector('[data-mollie-components-target="fields"]'));
    }

    _loadMollieJs() {
      return new Promise(function(resolve, reject) {
        if (window.Mollie) { resolve(); return; }
        var existing = document.querySelector('script[src="' + MOLLIE_JS + '"]');
        if (existing) {
          existing.addEventListener('load', function() { resolve(); });
          existing.addEventListener('error', function() { reject(new Error('Failed to load Mollie.js')); });
          return;
        }
        var s = document.createElement('script');
        s.src = MOLLIE_JS;
        s.async = true;
        s.onload = function() { resolve(); };
        s.onerror = function() { reject(new Error('Failed to load Mollie.js')); };
        document.head.appendChild(s);
      });
    }

    _setLoading(on) {
      if (this.hasSubmitButtonTarget) {
        this.submitButtonTarget.disabled = on;
        this.submitButtonTarget.classList.toggle('processing', on);
      }
    }

    _showError(msg) {
      if (this.hasErrorTarget && this.hasErrorMessageTarget) {
        this.errorMessageTarget.textContent = msg;
        this.errorTarget.style.display = 'block';
      }
    }

    _hideError() {
      if (this.hasErrorTarget) this.errorTarget.style.display = 'none';
    }
  }

  opc.stimulus.register('mollie-checkout-footer', MollieCheckoutFooterController);

  // -----------------------------------------------------------------------
  // mollie-user-data-validator (MOL-15)
  //
  // Wraps mollie-checkout-footer#submitPayment: POSTs the live OPC address fields to payment-base's
  // central validation endpoint (cl=oepaymentvalidationapi&fnc=validate) with Mollie's module id and
  // the CSRF token, renders each rejected field with `.is-invalid` + the server-formatted message
  // ("The street field is not valid. Allowed symbols are: …"), and raises `oe:payment:error` so OPC's
  // notice shows the review hint. Releases the submit on `valid:true`.
  //
  // Fail-open: on HTTP 4xx/5xx (a guard refused, transient error) or a network failure the submit is
  // released - the server-side gate in the standard checkout is the source of truth; this is the
  // shopper-facing early feedback. Inline (not in the module bundle) on purpose: it must register on
  // OPC's Stimulus application to find the footer controller instance.
  //
  // OPC address inputs carry data-billing-address-target / data-delivery-address-target
  // (one-page-checkout/.../checkout-steps/billing-address.html.twig): firstName, lastName, street,
  // streetNumber, zipCode, city.
  // -----------------------------------------------------------------------
  class MollieUserDataValidatorController extends BaseController {
    static values = {
      url: String,
      pluginId: String,
      csrf: String,
      allowed: Object,
      reviewMessage: String
    }

    connect() {
      this._wrapSubmitPayment();
      this._attachClearOnInputListeners();
    }

    disconnect() {
      this._unwrapSubmitPayment();
      this._detachClearOnInputListeners();
    }

    // Logical field (payment-base rules) -> OPC address target. One map for collect / render / clear.
    _fieldTargetMap() {
      return {
        firstName: 'firstName',
        lastName: 'lastName',
        street: 'street',
        houseNumber: 'streetNumber',
        postalCode: 'zipCode',
        city: 'city'
      };
    }

    _fieldNodes(target) {
      return document.querySelectorAll(
        '[data-billing-address-target="' + target + '"], [data-delivery-address-target="' + target + '"]'
      );
    }

    _wrapSubmitPayment() {
      var footer = this.application.getControllerForElementAndIdentifier(this.element, 'mollie-checkout-footer');
      if (!footer) {
        return;
      }
      this._footer = footer;
      this._originalSubmit = footer.submitPayment.bind(footer);
      footer.submitPayment = this._interceptSubmit.bind(this);
    }

    _unwrapSubmitPayment() {
      if (this._footer && this._originalSubmit) {
        this._footer.submitPayment = this._originalSubmit;
      }
    }

    async _interceptSubmit(event) {
      if (event) event.preventDefault();
      this._clearErrors();

      var fields = this._collectFields();
      if (Object.keys(fields).length === 0) {
        this._originalSubmit(event);
        return;
      }

      try {
        var body = new FormData();
        body.append('pluginModuleId', this.pluginIdValue);
        body.append('stoken', this.csrfValue);
        for (var [name, value] of Object.entries(fields)) {
          body.append(name, value);
        }
        var response = await fetch(this.urlValue, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
          body: body
        });
        if (!response.ok) {
          this._originalSubmit(event);
          return;
        }
        var data = await response.json();
        if (data.valid) {
          this._originalSubmit(event);
          return;
        }
        this._renderErrors(data.errors || []);
      } catch (err) {
        console.error('[MollieUserDataValidator] validation request failed, releasing submit:', err);
        this._originalSubmit(event);
      }
    }

    _collectFields() {
      var out = {};
      for (var [logical, target] of Object.entries(this._fieldTargetMap())) {
        for (var el of this._fieldNodes(target)) {
          var value = el && typeof el.value === 'string' ? el.value.trim() : '';
          if (value !== '') { out[logical] = value; break; }
        }
      }
      return out;
    }

    _renderErrors(errors) {
      if (!Array.isArray(errors) || errors.length === 0) {
        return;
      }
      var allowed = this.allowedValue || {};
      var targets = this._fieldTargetMap();
      var violated = [];
      for (var err of errors) {
        violated.push({ field: err.field, allowed: allowed[err.field] || '' });
        var target = err && err.field ? targets[err.field] : null;
        if (!target) continue;
        for (var el of this._fieldNodes(target)) {
          el.classList.add('is-invalid');
          this._removeFeedback(el);
          var feedback = document.createElement('div');
          feedback.className = 'invalid-feedback d-block';
          feedback.setAttribute('data-mollie-validation', 'true');
          feedback.textContent = (err.message || '').toString().trim() || 'Invalid value';
          el.insertAdjacentElement('afterend', feedback);
        }
      }
      document.dispatchEvent(new CustomEvent('oe:payment:error', {
        detail: { message: this.reviewMessageValue || 'Please review your address details.', fields: violated }
      }));
    }

    _removeFeedback(el) {
      var feedback = el.parentElement && el.parentElement.querySelector('.invalid-feedback[data-mollie-validation]');
      if (feedback) feedback.remove();
    }

    _clearErrors() {
      for (var target of Object.values(this._fieldTargetMap())) {
        for (var el of this._fieldNodes(target)) {
          el.classList.remove('is-invalid');
          this._removeFeedback(el);
        }
      }
    }

    _attachClearOnInputListeners() {
      this._inputListeners = [];
      for (var target of Object.values(this._fieldTargetMap())) {
        for (var el of this._fieldNodes(target)) {
          var handler = function (element) {
            element.classList.remove('is-invalid');
            this._removeFeedback(element);
          }.bind(this, el);
          el.addEventListener('input', handler);
          this._inputListeners.push({ el: el, handler: handler });
        }
      }
    }

    _detachClearOnInputListeners() {
      for (var rec of (this._inputListeners || [])) {
        rec.el.removeEventListener('input', rec.handler);
      }
      this._inputListeners = [];
    }
  }

  opc.stimulus.register('mollie-user-data-validator', MollieUserDataValidatorController);
})();
</script>

<style>
  .checkout-footer-mollie .mollie-field { min-height: 2.6rem; padding-top: .55rem; }
  .checkout-footer-mollie .mollie-method-icon { object-fit: contain; }
  .checkout-footer-mollie button[disabled] { opacity: 0.6; cursor: not-allowed; }
  .checkout-footer-mollie button.processing { opacity: 0.8; }
</style>
