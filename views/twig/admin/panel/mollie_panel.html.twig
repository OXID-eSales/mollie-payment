{# ============================================================================
   Sprint 7 — Mollie panel body (renders inside payment-base's shared admin
   "Payment" tab wrapper: @oe_payment_base/admin/payment_admin_tab).
   Body-only: no head, no transfer form, no admin frame closes — the shared
   wrapper owns all of that.

   View-data shape produced by MolliePanelViewDataBuilder::build():
   - orderId, orderNumber, paymentType, paymentMethod, contractId, providerOrderId, contractState, currency
   - capturedAmount, refundedAmount (formatted strings)
   - captureBound/captureBoundFormatted, refundBound/refundBoundFormatted
   - isCapturable, isRefundable, isCancellable
   - dashboardUrl (optional), errorMessage (optional)
   - transactions: list<TransactionRow> (type/id/amount/currency/status/createdAt/badgeTone())
   - validationErrors: list<string> (Story 3 — consumed once per render)
   ============================================================================ #}

{# Mollie brand color for the shared .pc-btn-primary. The base tab holds only
   a neutral fallback; each provider owns its brand via --pc-brand. #}
<style>
    .pc-admin[data-provider="mollie"] { --pc-brand: #0057ff; }
</style>

{% if errorMessage is defined and errorMessage %}
    <div class="pc-alert pc-alert-info" data-testid="mollie-panel-error">{{ errorMessage }}</div>
{% endif %}

{% if validationErrors is defined and validationErrors|length > 0 %}
    <div class="pc-alert pc-alert-danger" data-testid="mollie-validation-errors">
        {% for message in validationErrors %}
            <p class="mb-0">{{ message }}</p>
        {% endfor %}
    </div>
{% endif %}

{% if contractId is defined and contractId %}
    <h2>{{ "MOLLIE_ORDER_PAYMENT_DETAILS"|translate }}</h2>

    <table class="pc-card" data-testid="mollie-panel-card">
        <tbody>
        <tr>
            <th class="pc-label">{{ "MOLLIE_ORDER_NUMBER"|translate }}</th>
            <td class="pc-value" data-testid="order-number">
                {% if orderNumber is defined and orderNumber and orderNumber != '0' %}
                    <strong>{{ orderNumber }}</strong>
                {% else %}
                    —
                {% endif %}
            </td>
        </tr>
        <tr>
            <th class="pc-label">{{ "MOLLIE_CONTRACT_ID"|translate }}</th>
            <td class="pc-value"><code data-testid="contract-id">{{ contractId|default('—') }}</code></td>
        </tr>
        <tr>
            <th class="pc-label">{{ "MOLLIE_PAYMENT_ID"|translate }}</th>
            <td class="pc-value">
                {% if providerOrderId is defined and providerOrderId %}
                    {% if dashboardUrl is defined and dashboardUrl %}
                        <a href="{{ dashboardUrl }}" target="_blank" rel="noopener" data-testid="mollie-dashboard-link">{{ providerOrderId }}</a>
                    {% else %}
                        <code data-testid="mollie-payment-id">{{ providerOrderId }}</code>
                    {% endif %}
                {% else %}
                    —
                {% endif %}
            </td>
        </tr>
        <tr>
            <th class="pc-label">{{ "MOLLIE_PAYMENT_TYPE"|translate }}</th>
            <td class="pc-value" data-testid="payment-type">{{ paymentType|default('—') }}</td>
        </tr>
        {# Sprint 136: the method the customer actually paid with, from the live
           Mollie payment. The row above is the shop's payment-method id and is
           identical for every Mollie order. #}
        <tr>
            <th class="pc-label">{{ "MOLLIE_PAYMENT_METHOD_USED"|translate }}</th>
            <td class="pc-value" data-testid="payment-method-used">
                {% if paymentMethod is defined and paymentMethod.isKnown %}
                    <strong>{{ paymentMethod.label }}</strong>
                    {%- if paymentMethod.detail %}
                        <span class="pc-muted">&middot; {{ paymentMethod.detail }}</span>
                    {%- endif %}
                {% else %}
                    &mdash;
                {% endif %}
            </td>
        </tr>
        <tr>
            <th class="pc-label">{{ "MOLLIE_CONTRACT_STATE"|translate }}</th>
            <td class="pc-value">{{ contractState|default('—') }}</td>
        </tr>
        <tr>
            <th class="pc-label">{{ "MOLLIE_CAPTURED_AMOUNT"|translate }}</th>
            <td class="pc-value" data-testid="captured-amount">{{ capturedAmount|default('0.00') }} {{ currency|default('') }}</td>
        </tr>
        <tr>
            <th class="pc-label">{{ "MOLLIE_REFUNDED_AMOUNT"|translate }}</th>
            <td class="pc-value" data-testid="refunded-amount">{{ refundedAmount|default('0.00') }} {{ currency|default('') }}</td>
        </tr>
        </tbody>
    </table>

    {# ===== Transaction history (Story 2 — live Mollie API source of truth) ===== #}
    {% if transactions is defined and transactions|length > 0 %}
        <div class="pc-card">
            <div class="pc-card-header">{{ "MOLLIE_TRANSACTION_HISTORY"|translate }}</div>
            <div class="pc-card-body">
                <table class="pc-table" data-testid="mollie-transaction-history">
                    <thead>
                    <tr>
                        <th>{{ "MOLLIE_TRANSACTION_TYPE"|translate }}</th>
                        <th>{{ "MOLLIE_TRANSACTION_ID"|translate }}</th>
                        <th class="text-right">{{ "MOLLIE_AMOUNT"|translate }}</th>
                        <th>{{ "MOLLIE_TRANSACTION_STATUS"|translate }}</th>
                        <th>{{ "MOLLIE_TRANSACTION_DATE"|translate }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in transactions %}
                        <tr data-testid="mollie-transaction-row">
                            <td>{{ row.type }}</td>
                            <td><code>{{ row.id }}</code></td>
                            <td class="text-right">{{ '%.2f'|format(row.amount) }} {{ row.currency }}</td>
                            <td><span class="pc-badge pc-badge-{{ row.badgeTone() == 'success' ? 'green' : (row.badgeTone() == 'warning' ? 'orange' : (row.badgeTone() == 'danger' ? 'blue' : 'gray')) }}">{{ row.status }}</span></td>
                            <td>{{ row.createdAt ? row.createdAt|date('Y-m-d H:i') : '—' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {# ===== Capture section (two-step / manual capture) ===== #}
    {% if isCapturable is defined and isCapturable %}
        <div class="pc-card">
            <div class="pc-card-header">{{ "MOLLIE_CAPTURE"|translate }}</div>
            <div class="pc-card-body">
                <form name="mollieCaptureForm" id="mollieCaptureForm" action="{{ oViewConf.getSelfLink() }}" method="post"
                      class="js-payment-action-form" data-testid="mollie-capture-form">
                    {{ oViewConf.getHiddenSid()|raw }}
                    <input type="hidden" name="cl" value="PaymentAdmin">
                    <input type="hidden" name="oxid" value="{{ orderId }}">
                    <input type="hidden" name="fnc" value="dispatchAction">
                    <input type="hidden" name="payment_admin_action" value="capture">

                    <p>{{ "MOLLIE_CAPTURABLE_AMOUNT"|translate }}:
                        <strong>{{ captureBoundFormatted }} {{ currency }}</strong></p>

                    <div class="pc-form-row">
                        <div class="pc-form-group">
                            <label class="pc-form-label" for="capture_amount">{{ "MOLLIE_AMOUNT"|translate }} ({{ currency }})</label>
                            <input type="number" class="pc-form-input" id="capture_amount" name="capture_amount"
                                   value="{{ captureBound }}" step="0.01" min="0.01"
                                   max="{{ captureBound }}" data-testid="capture-amount-input">
                        </div>
                        <div class="pc-form-group">
                            <label class="pc-form-label" for="capture_reason">{{ "MOLLIE_CAPTURE_REASON"|translate }}</label>
                            <input type="text" class="pc-form-input" id="capture_reason" name="capture_reason" maxlength="140">
                        </div>
                    </div>

                    <input type="submit" class="pc-btn pc-btn-primary" data-testid="capture-submit"
                           value="{{ "MOLLIE_CAPTURE_SUBMIT"|translate }}"
                           onclick="return confirm('{{ "MOLLIE_CAPTURE_CONFIRM"|translate }}');">
                </form>
            </div>
        </div>
    {% endif %}

    {# ===== Refund section ===== #}
    {% if isRefundable is defined and isRefundable %}
        <div class="pc-card">
            <div class="pc-card-header">{{ "MOLLIE_REFUND"|translate }}</div>
            <div class="pc-card-body">
                <form name="mollieRefundForm" id="mollieRefundForm" action="{{ oViewConf.getSelfLink() }}" method="post"
                      class="js-payment-action-form" data-testid="mollie-refund-form">
                    {{ oViewConf.getHiddenSid()|raw }}
                    <input type="hidden" name="cl" value="PaymentAdmin">
                    <input type="hidden" name="oxid" value="{{ orderId }}">
                    <input type="hidden" name="fnc" value="dispatchAction">
                    <input type="hidden" name="payment_admin_action" value="refund">

                    <p>{{ "MOLLIE_REFUNDABLE_AMOUNT"|translate }}:
                        <strong>{{ refundBoundFormatted }} {{ currency }}</strong></p>

                    <div class="pc-form-row">
                        <div class="pc-form-group">
                            <label class="pc-form-label" for="refund_amount">{{ "MOLLIE_AMOUNT"|translate }} ({{ currency }})</label>
                            <input type="number" class="pc-form-input" id="refund_amount" name="refund_amount"
                                   value="{{ refundBound }}" step="0.01" min="0.01"
                                   max="{{ refundBound }}" data-testid="refund-amount-input">
                        </div>
                        <div class="pc-form-group">
                            <label class="pc-form-label" for="refund_reason">{{ "MOLLIE_REFUND_REASON"|translate }}</label>
                            <select class="pc-form-input" id="refund_reason" name="refund_reason" data-testid="refund-reason-select">
                                <option value="">{{ "MOLLIE_PLEASE_SELECT"|translate }}</option>
                                <option value="requested_by_customer">{{ "MOLLIE_REASON_REQUESTED_BY_CUSTOMER"|translate }}</option>
                                <option value="duplicate">{{ "MOLLIE_REASON_DUPLICATE"|translate }}</option>
                                <option value="fraudulent">{{ "MOLLIE_REASON_FRAUDULENT"|translate }}</option>
                            </select>
                        </div>
                    </div>

                    {# Story 3 (Sprint 9): Optional admin description for audit trail #}
                    <div class="pc-form-group">
                        <label class="pc-form-label" for="refund_description">{{ "MOLLIE_REFUND_DESCRIPTION"|translate }}</label>
                        <input type="text" class="pc-form-input" id="refund_description" name="refund_description"
                               maxlength="140" placeholder="{{ "MOLLIE_REFUND_DESCRIPTION_PLACEHOLDER"|translate }}"
                               data-testid="refund-description-input">
                    </div>

                    <input type="submit" class="pc-btn pc-btn-warning" data-testid="refund-submit"
                           value="{{ "MOLLIE_REFUND_SUBMIT"|translate }}"
                           onclick="return confirm('{{ "MOLLIE_REFUND_CONFIRM"|translate }}');">
                </form>
            </div>
        </div>
    {% endif %}

    {# ===== Cancel authorization section ===== #}
    {% if isCancellable is defined and isCancellable %}
        <div class="pc-card">
            <div class="pc-card-header">{{ "MOLLIE_CANCEL"|translate }}</div>
            <div class="pc-card-body">
                <form name="mollieCancelForm" id="mollieCancelForm" action="{{ oViewConf.getSelfLink() }}" method="post"
                      class="js-payment-action-form" data-testid="mollie-cancel-form">
                    {{ oViewConf.getHiddenSid()|raw }}
                    <input type="hidden" name="cl" value="PaymentAdmin">
                    <input type="hidden" name="oxid" value="{{ orderId }}">
                    <input type="hidden" name="fnc" value="dispatchAction">
                    <input type="hidden" name="payment_admin_action" value="cancel">

                    <div class="pc-form-row">
                        <div class="pc-form-group">
                            <label class="pc-form-label" for="cancel_reason">{{ "MOLLIE_CANCEL_REASON"|translate }}</label>
                            <select class="pc-form-input" id="cancel_reason" name="cancel_reason" data-testid="cancel-reason-select">
                                <option value="">{{ "MOLLIE_PLEASE_SELECT"|translate }}</option>
                                <option value="requested_by_customer">{{ "MOLLIE_REASON_REQUESTED_BY_CUSTOMER"|translate }}</option>
                                <option value="duplicate">{{ "MOLLIE_REASON_DUPLICATE"|translate }}</option>
                                <option value="fraudulent">{{ "MOLLIE_REASON_FRAUDULENT"|translate }}</option>
                                <option value="abandoned">{{ "MOLLIE_REASON_ABANDONED"|translate }}</option>
                            </select>
                        </div>
                    </div>

                    <input type="submit" class="pc-btn pc-btn-danger-outline" data-testid="cancel-submit"
                           value="{{ "MOLLIE_CANCEL_SUBMIT"|translate }}"
                           onclick="return confirm('{{ "MOLLIE_CANCEL_CONFIRM"|translate }}');">
                </form>
            </div>
        </div>
    {% endif %}
{% else %}
    <div class="pc-empty" data-testid="mollie-no-contract">{{ "MOLLIE_NO_CONTRACT"|translate }}</div>
{% endif %}
