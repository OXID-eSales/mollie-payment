{#
 # IFRAME-04: Mollie inline payment-method selection on the standard cl=order page.
 #
 # When the payment-base "Use iframe instead of checkout button" flag is ON and a Mollie profile id
 # is configured, the shopper picks a specific Mollie method here (iDEAL, PayPal, card, …) instead of
 # being sent to Mollie's own method-selection page. "Card" is entered INLINE via Mollie Components
 # (js.mollie.com iframes); every other method redirects to Mollie on submit with that method
 # preselected. Non-Mollie payments fall through to the core template unchanged; if the method list
 # can't be fetched, we also fall back to the classic redirect button.
 #}
{% extends "page/checkout/order.html.twig" %}

{% block checkout_order_next_step_side %}
    {% set molliePayment = oView.getPayment() and oView.getPayment().getId() == oViewConf.getMollieModuleId() %}
    {% set mollieInlineCard = molliePayment and oViewConf.isMollieInlineCardEnabled() %}
    {% set mollieMethods = mollieInlineCard ? oViewConf.getMollieMethods() : [] %}
    {% set displayBasketOrderButton = oViewConf.getViewThemeParam('basketLowOrderDisplayOrderButton') %}
    {% if not molliePayment %}
        {{ parent() }}
    {% elseif not mollieInlineCard or mollieMethods is empty %}
        {# MOL-18: classic redirect flow - apex's own button, apex's own conditions, plus a
           Stimulus controller that lets it submit once per click burst (the server rejoins an
           attempt already in flight, so this is UX). The inline onclick stays as the fallback
           for a page where the bundle did not load; the controller removes it on connect.
           MOL-11: mollie-agb-gate keeps the button inactive until the AGB checkbox is ticked
           (no checkbox rendered -> nothing to gate on); the server guard stays the safety net. #}
        {% if not oView.isLowOrderPrice() or (displayBasketOrderButton == 'show' or displayBasketOrderButton == 'disabled') %}
            <script>
                window.oMollie = window.oMollie || {};
                window.oMollie.debug = {{ oViewConf.isMollieDebugLoggingEnabled() ? 'true' : 'false' }};
            </script>
            <script src="{{ oViewConf.getModuleUrl('oe_payments_mollie', oViewConf.getMollieJsPath()) }}?v={{ oViewConf.getMollieModuleVersion() }}"></script>
            <button type="button" class="btn btn-highlight btn-lg w-100"
                    data-controller="mollie-place-order mollie-agb-gate"
                    data-action="click->mollie-place-order#submit"
                    {% if oView.isLowOrderPrice() and displayBasketOrderButton == 'disabled' %}
                    disabled="disabled"
                    {% else %}
                    onclick="document.getElementById('orderConfirmAgbBottom').submit();"
                    {% endif %}
            >
                {{ translate({ ident: "SUBMIT_ORDER" }) }}
            </button>
        {% endif %}
    {% else %}
        {% if not oView.isLowOrderPrice() or (displayBasketOrderButton == 'show' or displayBasketOrderButton == 'disabled') %}
            {# Mollie Components JS is emitted here (not in base_js) because the core order template
               captures its body rather than extending the layout, so base_js overrides collide
               across payment modules. Body scripts execute fine (Stripe loads its bundle the same
               way on this page); app.js reuses any existing Stimulus app so load order is safe. #}
            <script>
                window.oMollie = window.oMollie || {};
                window.oMollie.debug = {{ oViewConf.isMollieDebugLoggingEnabled() ? 'true' : 'false' }};
            </script>
            <script src="{{ oViewConf.getModuleUrl('oe_payments_mollie', oViewConf.getMollieJsPath()) }}?v={{ oViewConf.getMollieModuleVersion() }}"></script>

            {# MOL-9: mollie-agb-gate on the block - the method selector and the card fields (its
               `region`) are inert and dimmed, the button (its `button`) disabled, until every
               agreement checkbox is ticked; nothing to gate on when none is rendered. #}
            <div data-controller="mollie-components mollie-agb-gate"
                 data-mollie-components-profile-id-value="{{ oViewConf.getMollieProfileId() }}"
                 data-mollie-components-testmode-value="{{ oViewConf.isMollieTestMode() ? 'true' : 'false' }}"
                 data-mollie-components-locale-value="{{ oViewConf.getMollieComponentsLocale() }}"
                 data-mollie-components-debug-value="{{ oViewConf.isMollieDebugLoggingEnabled() ? 'true' : 'false' }}">

              {# The method list is a card like the Summary and the Agreements above it (2026-10-01):
                 same `card mb-3`, same header classes as the order sections on the left. The AGB
                 gate's `region` is the whole card, so the header dims with the list while locked. #}
              <div class="card mb-3" data-mollie-agb-gate-target="region" data-testid="mollie-method-card">
                {% if mollieMethods|length == 1 %}
                    {# One enabled method is not a choice (the rule payment-base applies to the
                       payment and shipping cards): name it, don't offer a selector. The field stays
                       in the DOM — hidden, checked, form-associated — so the value still submits
                       with the core order form and the Components controller still reads
                       `input[name=mollieMethod]:checked` to decide on the card flow. #}
                    {% set m = mollieMethods|first %}
                    <h2 class="h4 card-header card-title card-header-edit d-flex justify-content-between align-items-center">
                        {{ translate({ ident: "PAYMENT_METHOD" }) }}
                    </h2>
                    <div class="card-body">
                        <input type="radio" name="mollieMethod" id="mollieMethod_{{ m.id }}" value="{{ m.id }}"
                               form="orderConfirmAgbBottom" checked hidden
                               data-mollie-order-method="fixed">
                        <p class="mb-0 d-flex align-items-center" data-mollie-order-card="method">
                            {% if m.image %}
                                <img src="{{ m.image }}" alt="" width="28" height="28" class="mollie-method-icon me-2">
                            {% endif %}
                            {{ m.name }}
                        </p>
                {% else %}
                    <h2 class="h4 card-header card-title card-header-edit d-flex justify-content-between align-items-center">
                        {{ translate({ ident: "MOLLIE_CHOOSE_METHOD" }) }}
                    </h2>
                    <div class="card-body">
                        <div class="mollie-methods">
                            {% for m in mollieMethods %}
                                <div class="form-check d-flex align-items-center py-1">
                                    {# name=mollieMethod + form= means the chosen method submits natively with
                                       the core order form; no JS needed to carry it for redirect methods. #}
                                    <input class="form-check-input me-2" type="radio" name="mollieMethod"
                                           id="mollieMethod_{{ m.id }}" value="{{ m.id }}"
                                           form="orderConfirmAgbBottom"
                                           {% if loop.first %}checked{% endif %}
                                           data-action="change->mollie-components#flowChanged">
                                    <label class="form-check-label d-flex align-items-center" for="mollieMethod_{{ m.id }}">
                                        {% if m.image %}
                                            <img src="{{ m.image }}" alt="" width="28" height="28" class="mollie-method-icon me-2">
                                        {% endif %}
                                        {{ m.name }}
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                {% endif %}

                        {# Inline card fields — shown by the controller only when "creditcard" is selected.
                           Mollie hosts the inputs in its iframes and ships them without a placeholder, so
                           the card-number mount carries one (`data-placeholder`, drawn by CSS) that the
                           controller hides while the field is focused or filled. #}
                        <div data-mollie-components-target="fields" class="mollie-card-fields mt-3" style="display: none;">
                            <label class="form-label">{{ translate({ ident: "MOLLIE_CARD_NUMBER" }) }}</label>
                            <div data-mollie-components-target="cardNumber" class="mollie-field form-control mb-2"
                                 data-placeholder="{{ translate({ ident: "MOLLIE_CARD_NUMBER_PLACEHOLDER" }) }}"></div>

                            {# Not "(optional)": Mollie Components refuse to tokenize without a card holder
                               (measured 2026-10-01 — every other field valid, holder empty → "Ein oder
                               mehrere Felder sind ungültig"). #}
                            <label class="form-label" data-testid="mollie-card-holder-label">{{ translate({ ident: "MOLLIE_CARD_HOLDER" }) }}</label>
                            <div data-mollie-components-target="cardHolder" class="mollie-field form-control mb-2"></div>

                            <div class="row">
                                <div class="col">
                                    <label class="form-label">{{ translate({ ident: "MOLLIE_CARD_EXPIRY" }) }}</label>
                                    <div data-mollie-components-target="expiryDate" class="mollie-field form-control"></div>
                                </div>
                                <div class="col">
                                    <label class="form-label">{{ translate({ ident: "MOLLIE_CARD_CVC" }) }}</label>
                                    <div data-mollie-components-target="verificationCode" class="mollie-field form-control"></div>
                                </div>
                            </div>
                        </div>
                    </div>
              </div>

                <div class="alert alert-danger" role="alert" style="display: none;"
                     data-mollie-components-target="error"></div>

                {# Card token (populated by Components on submit); submitted with the core order form. #}
                <input type="hidden" name="mollieCardToken" form="orderConfirmAgbBottom"
                       data-mollie-components-target="token">

                {# MOL-11 / MOL-9: the block's gate disables this button with the region. #}
                <button type="button" class="btn btn-highlight btn-lg w-100"
                        data-mollie-agb-gate-target="button"
                        data-action="click->mollie-components#placeOrder"
                        {% if oView.isLowOrderPrice() and displayBasketOrderButton == 'disabled' %}
                            disabled="disabled"
                        {% endif %}>
                    {{ translate({ ident: "SUBMIT_ORDER" }) }}
                </button>
            </div>

            <style>
                .mollie-field { position: relative; min-height: 2.6rem; padding-top: .55rem; }
                /* The shop's placeholder for Mollie's placeholder-less hosted input; the controller
                   drops it (is-focused / is-filled) as soon as the shopper types. */
                .mollie-field[data-placeholder]::before {
                    content: attr(data-placeholder); position: absolute; left: .75rem; right: .75rem; top: .55rem;
                    color: #6c757d; opacity: .65; pointer-events: none; white-space: nowrap; overflow: hidden;
                }
                .mollie-field.is-focused::before, .mollie-field.is-filled::before { content: none; }
                .mollie-method-icon { object-fit: contain; }
                /* MOL-9: the region is `inert` while locked; this dims it and is the pointer fallback. */
                .mollie-agb-locked { opacity: .5; pointer-events: none; }
            </style>
        {% endif %}
    {% endif %}
{% endblock %}
