{# ============================================================================
   Sprint 7 Story 5 — Mollie method selector on the standard payment-selection
   step. Mollie has no on-page redirect step of its own: MolliePaymentController
   (extends core PaymentController) intercepts this form's classic POST and
   redirects straight to Mollie's hosted checkout once the customer continues —
   the method chosen here travels through as the `mollie_method` field, read by
   PaymentController::selectedMollieMethod() and threaded onto the checkout
   session request as CreatePaymentRequest::method.
   ============================================================================ #}
{% extends "page/checkout/payment.html.twig" %}

{% block select_payment %}
    {% if sPaymentID == "oe_payments_mollie" %}
        <div class="payment-option" data-testid="mollie-payment-option">
            <div class="payment-option-form">
                <input class="form-check-input" id="payment_{{ sPaymentID }}" type="radio" name="paymentid"
                       value="{{ sPaymentID }}"
                       {% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %}checked{% endif %}>
                <label class="form-check-label" for="payment_{{ sPaymentID }}">{{ paymentmethod.oxpayments__oxdesc.value }}</label>

                <div class="mollie-method-wrapper{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} activePayment{% endif %}"
                     data-controller="mollie-checkout"
                     data-mollie-checkout-debug-value="{{ oViewConf.isMollieDebugLoggingEnabled() ? 'true' : 'false' }}">
                    {% include "@oe_payments_mollie/frontend/mollie_methods.html.twig" %}

                    {% if paymentmethod.oxpayments__oxlongdesc.value|striptags|trim %}
                        <div class="desc">{{ paymentmethod.oxpayments__oxlongdesc.value|raw }}</div>
                    {% endif %}
                </div>
            </div>
            {% if paymentmethod.getPrice() %}
                <div class="payment-option-price">
                    {% set oPaymentPrice = paymentmethod.getPrice() %}
                    {% if oViewConf.isFunctionalityEnabled('blShowVATForPayCharge') %}
                        {% apply spaceless %}
                            {{ format_price(oPaymentPrice.getNettoPrice(), { currency: currency }) }}
                            {% if oPaymentPrice.getVatValue() > 0 %}
                                {{ translate({ ident: "PLUS_VAT" }) }} {{ format_price(oPaymentPrice.getVatValue(), { currency: currency }) }}
                            {% endif %}
                        {% endapply %}
                    {% else %}
                        {{ format_price(oPaymentPrice.getBruttoPrice(), { currency: currency }) }}
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
