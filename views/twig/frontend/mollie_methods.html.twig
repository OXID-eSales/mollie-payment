{# ============================================================================
   Sprint 7 Story 5 — Mollie method selector (iDEAL, credit card, …).

   Included from the Mollie radio option in the overridden payment-selection
   page (views/twig/extensions/themes/default/page/checkout/payment.html.twig).
   `oViewConf.getMollieActiveMethods()` returns list<MollieMethodDto> (id,
   description, imageUrl), filtered by supported currency and the customer's
   active shop currency (Sprint 7 Story 5's PaymentMethodListService).
   ============================================================================ #}
{#  Loaded here (rather than via the `base_js` layout block) because this partial is only
    included once — exactly where the Mollie payment option renders — and doesn't depend on
    whether `{% include %}` boundaries propagate Twig block inheritance from the page layout. #}
<script src="{{ oViewConf.getModuleUrl('oe_payments_mollie', 'assets/js/mollie-frontend.min.js') }}" defer></script>

{% set mollieMethods = oViewConf.getMollieActiveMethods() %}

{% if mollieMethods|length > 0 %}
    <div class="mollie-methods" data-testid="mollie-methods">
        {% for method in mollieMethods %}
            <label class="mollie-method form-check" data-mollie-checkout-target="method">
                <input class="form-check-input" type="radio" name="mollie_method" value="{{ method.id }}"
                       data-action="change->mollie-checkout#methodSelected"
                       {% if loop.first %}checked{% endif %}>
                {% if method.imageUrl %}
                    <img src="{{ method.imageUrl }}" alt="{{ method.description }}" class="mollie-method-icon" width="32" height="24" loading="lazy">
                {% endif %}
                <span class="form-check-label">{{ method.description }}</span>
            </label>
        {% endfor %}
    </div>
{% else %}
    <p class="mollie-methods-empty text-muted" data-testid="mollie-methods-empty">
        {{ "MOLLIE_METHODS_UNAVAILABLE"|translate }}
    </p>
{% endif %}
